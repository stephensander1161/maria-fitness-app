# ── secrets: never commit ─────────────────────────────────────────────────────
# .env* is deliberately broad; the example file is the one explicit exception.
.env*
!.env.example
*.pem
*.key

# ── dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── build output ──────────────────────────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── runtime / tooling ─────────────────────────────────────────────────────────
.vercel
/coverage
.turbo

# ── os / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
