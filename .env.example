# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key. Read only in server code, never shipped to the browser.
# Use a key from a dedicated Console workspace with a monthly spend limit set.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Neon: use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this immediately logs out every device.
AUTH_SECRET=

# The passphrase she types once per device to get in.
APP_PASSPHRASE=

# Her IANA timezone. Day-level dates (workouts, weigh-ins, meals) are computed
# in this zone. Vercel functions run UTC, so leaving this unset means evening
# activity is recorded against the following day. e.g. America/Edmonton
APP_TIMEZONE=UTC

# ── Optional ──────────────────────────────────────────────────────────────────

# Hard daily spend ceiling, in millionths of a dollar. 500000 = $0.50/day.
# When exceeded, chat pauses until tomorrow; every other screen keeps working.
# DAILY_COST_LIMIT_MICROS=500000

# Other guard rails (defaults shown).
# MAX_CHAT_PER_DAY=250
# MAX_CHAT_PER_MINUTE=8
# MAX_LOGIN_ATTEMPTS_PER_HOUR=10
# MAX_MESSAGE_CHARS=4000

# Override the coach model. Defaults to claude-haiku-4-5.
# If you change this, update PRICING in lib/agent/model.ts or the spend cap
# will be computing costs for the wrong model.
# COACH_MODEL=claude-opus-5
