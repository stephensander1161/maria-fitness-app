# Anthropic API key — drives the coach. Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. Neon: copy the *pooled* connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: override the coach model. Defaults to claude-haiku-4-5.
# COACH_MODEL=claude-opus-5
